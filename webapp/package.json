{
  "name": "leshan-server-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite --host 0.0.0.0",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview  --host 0.0.0.0",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix src",
    "sbom_maven": "echo 'SBOM generation skipped'"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.0.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.0",
    "digitspark-dialog": "^2.0.8",
    "file-saver": "^2.0.5",
    "vue": "^3.5.0",
    "vue-preferences": "^3.0.0",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.0",
    "vuetify-dialog": "^2.0.17"
  },
  "devDependencies": {
    "@mdi/js": "^3.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "browserslist-to-esbuild": "^1.2.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "sass": "^1.70.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "8.2.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {
      "vue/valid-v-slot": [
        "error",
        {
          "allowModifiers": true
        }
      ],
      "vue/multi-word-component-names": [
        "error",
        {
          "ignores": [
            "About",
            "Client",
            "Clients",
            "Security"
          ]
        }
      ]
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
