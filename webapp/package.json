{
  "name": "leshan-server-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite --host 0.0.0.0",
    "build": "vite build --emptyOutDir --sourcemap inline --minify false",
    "preview": "vite preview  --host 0.0.0.0",
    "lint": "eslint --fix src",
    "type-check": "tsc --noEmit",
    "sbom_maven": "echo 'SBOM generation skipped'"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "digitspark-dialog": "^2.0.8",
    "file-saver": "^2.0.5",
    "vue": "^3.5.41",
    "vue-preferences": "^3.0.0",
    "vue-router": "^5.2.0",
    "vue-sse": "^2.5.2",
    "vuetify": "^4.1.11",
    "vuetify-dialog": "^2.0.17"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "sass": "^1.103.1",
    "typescript": "^7.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.2.4",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {
      "vue/valid-v-slot": [
        "error",
        {
          "allowModifiers": true
        }
      ],
      "vue/multi-word-component-names": [
        "error",
        {
          "ignores": [
            "About",
            "Client",
            "Clients",
            "Security"
          ]
        }
      ]
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "overrides": {
    "uuid": "^11.1.1"
  }
}
